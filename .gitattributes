# Run logs and trace fixtures must keep LF line endings (spec 11.5).
*.runlog.jsonl text eol=lf
test/fixtures/otlp/* text eol=lf

# The demo run fixture is read as bytes and hashed, so its line endings must not change.
test/fixtures/demo-run-trace.json text eol=lf
test/fixtures/demo-run-variant-trace.json text eol=lf

# Synthetic exporter fixtures are compared byte for byte with their generator.
test/fixtures/exporters/*.json text eol=lf
